#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';
require BASE_PATH . '/database/Schema.php';

use App\Core\Db;

$cmd = $argv[1] ?? 'help';

switch ($cmd) {
    case 'migrate':
        foreach (Schema::statements(Db::driver()) as $sql) {
            Db::pdo()->exec($sql);
        }
        foreach (Schema::alters() as $name => $sql) {
            if (!Db::one('SELECT id FROM migrations WHERE name = ?', [$name])) {
                try {
                    Db::pdo()->exec($sql);
                } catch (\Throwable $e) {
                    // coluna já existe (instalação anterior): registra e segue
                    if (!preg_match('/duplicate column|already exists/i', $e->getMessage())) {
                        throw $e;
                    }
                }
                Db::run('INSERT INTO migrations (name) VALUES (?)', [$name]);
            }
        }
        echo "Tabelas criadas/atualizadas.\n";
        break;

    case 'seed':
        $data = require BASE_PATH . '/database/seeds/catalog.php';
        $pdo = Db::pdo();
        $pdo->beginTransaction();
        $catIds = [];
        foreach ($data['categories'] as $c) {
            if (!Db::one('SELECT id FROM categories WHERE slug = ?', [$c['slug']])) {
                Db::run('INSERT INTO categories (slug, name, type, sort_order) VALUES (?,?,?,?)', [$c['slug'], $c['name'], $c['type'], $c['sort_order']]);
            }
            $catIds[$c['slug']] = (int) Db::one('SELECT id FROM categories WHERE slug = ?', [$c['slug']])['id'];
        }
        $prodIds = [];
        foreach ($data['products'] as $p) {
            if (!Db::one('SELECT id FROM products WHERE slug = ?', [$p['slug']])) {
                Db::run(
                    'INSERT INTO products (slug, name, category_id, whmcs_group, sort_order) VALUES (?,?,?,?,?)',
                    [$p['slug'], $p['name'], $catIds[$p['cat']] ?? null, $p['whmcs_group'], $p['sort_order']]
                );
            }
            $prodIds[$p['slug']] = (int) Db::one('SELECT id FROM products WHERE slug = ?', [$p['slug']])['id'];
        }
        $n = 0;
        foreach ($data['plans'] as $pl) {
            $exists = Db::one('SELECT id FROM plans WHERE whmcs_pid = ?', [$pl['pid']]);
            // se o plano já existe, NÃO sobrescreve (preço pode ter sido ajustado no painel)
            if ($exists) {
                continue;
            }
            Db::run(
                'INSERT INTO plans (product_id, whmcs_pid, name, price_month, price_year, highlight, includes_site, specs, sort_order, synced_at)
                 VALUES (?,?,?,?,?,?,?,?,?,?)',
                [
                    $prodIds[$pl['product']], $pl['pid'], $pl['name'], $pl['price'], $pl['price_year'] ?? null,
                    $pl['highlight'] ?? 0, $pl['includes_site'] ?? 0,
                    json_encode($pl['specs'], JSON_UNESCAPED_UNICODE), $pl['sort'] ?? 0, date('Y-m-d H:i:s'),
                ]
            );
            $n++;
        }
        $pdo->commit();

        $dl = require BASE_PATH . '/database/seeds/downloads.php';
        $nd = 0;
        foreach ($dl as $d) {
            if (Db::one('SELECT id FROM downloads WHERE slug = ?', [$d['slug']])) {
                continue;
            }
            $own = !empty($d['own']);
            Db::run(
                'INSERT INTO downloads (category_id, slug, name, description, os, size_bytes, file_url, license_note, external, released_at)
                 VALUES (?,?,?,?,?,?,?,?,?,?)',
                [
                    $catIds[$d['cat']] ?? null, $d['slug'], $d['name'], $d['description'], $d['os'] ?? null,
                    $d['size_bytes'] ?? null, $own ? null : $d['file_url'], $d['license_note'] ?? null,
                    $own ? 0 : 1, $d['released_at'] ?? null,
                ]
            );
            $nd++;
        }
        echo "Downloads carregados ({$nd} novos).\n";
        echo "Catálogo carregado ({$n} planos novos).\n";
        break;

    case 'admin:create':
        $name = $argv[2] ?? '';
        $email = mb_strtolower(trim($argv[3] ?? ''));
        $pass = trim((string) fgets(STDIN));
        if ($name === '' || !filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($pass) < 10) {
            fwrite(STDERR, "Uso: printf 'SENHA-com-10+-caracteres' | bin/console admin:create \"Nome\" email@dominio\n");
            exit(1);
        }
        Db::run('INSERT INTO admins (name, email, password_hash) VALUES (?,?,?)', [$name, $email, password_hash($pass, PASSWORD_ARGON2ID)]);
        echo "Administrador criado.\n";
        break;

    case 'setting:set':
        $key = $argv[2] ?? '';
        $val = $argv[3] ?? '';
        if (!preg_match('/^[a-z0-9_]{2,100}$/', $key)) {
            fwrite(STDERR, "Uso: bin/console setting:set chave valor\n");
            exit(1);
        }
        App\Core\Settings::set($key, $val);
        echo "OK: {$key} atualizado.\n";
        break;

    case 'setting:list':
        foreach (Db::all('SELECT `skey`, `svalue` FROM settings ORDER BY `skey`') as $r) {
            $secret = preg_match('/(secret|token|pass|key)/i', (string) $r['skey']);
            echo $r['skey'] . ' = ' . ($secret ? '********' : $r['svalue']) . "\n";
        }
        break;

    case 'leads:list':
        foreach (Db::all('SELECT id, created_at, name, phone, interest, page, status FROM leads ORDER BY id DESC LIMIT 50') as $r) {
            echo "#{$r['id']} {$r['created_at']} | {$r['name']} | {$r['phone']} | {$r['interest']} | {$r['page']} | {$r['status']}\n";
        }
        break;

    case 'newsletter:send':
        // Para o cron (a cada 5 min): processa a campanha em envio, em lotes. Só inscritos confirmados.
        $lock = fopen(BASE_PATH . '/storage/cache/newsletter.lock', 'c');
        if (!flock($lock, LOCK_EX | LOCK_NB)) {
            echo "Outro envio em andamento.\n";
            break;
        }
        $total = ['sent' => 0, 'failed' => 0];
        for ($i = 0; $i < 20; $i++) {
            $r = App\Services\NewsletterSender::runBatch(50);
            $total['sent'] += $r['sent'];
            $total['failed'] += $r['failed'];
            if ($r['done']) {
                break;
            }
        }
        echo "Newsletter: {$total['sent']} enviados, {$total['failed']} falhas.\n";
        break;

    case 'admin:list':
        foreach (Db::all('SELECT id, name, email, role, last_login_at FROM admins ORDER BY id') as $r) {
            echo "#{$r['id']} {$r['email']} ({$r['name']}) último login: " . ($r['last_login_at'] ?: 'nunca') . "\n";
        }
        $t = Db::all("SELECT success, COUNT(*) n FROM login_attempts WHERE created_at > '" . date('Y-m-d H:i:s', time() - 3600) . "' GROUP BY success");
        foreach ($t as $r) {
            echo ($r['success'] ? 'logins ok' : 'logins falhos') . ' na última hora: ' . $r['n'] . "\n";
        }
        break;

    case 'admin:passwd':
        $email = mb_strtolower(trim($argv[2] ?? ''));
        $pass = trim((string) fgets(STDIN));
        if (!filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($pass) < 10) {
            fwrite(STDERR, "Uso: read -rs P; printf '%s' \"\$P\" | php bin/console admin:passwd email@dominio  (senha com 10+ caracteres)\n");
            exit(1);
        }
        $n = Db::run('UPDATE admins SET password_hash = ? WHERE email = ?', [password_hash($pass, PASSWORD_ARGON2ID), $email]);
        Db::run('DELETE FROM login_attempts');
        echo $n ? "Senha redefinida e bloqueios de login limpos.\n" : "Nenhum administrador com esse e-mail. Use admin:list.\n";
        break;

    case 'sitemap':
        require BASE_PATH . '/app/Core/Seo.php';
        file_put_contents(BASE_PATH . '/public/sitemap.xml', App\Core\Seo::sitemapXml());
        echo "sitemap.xml gerado.\n";
        break;

    default:
        echo "Comandos: migrate | seed | admin:create | sitemap | setting:set | setting:list | leads:list | newsletter:send | admin:list | admin:passwd\n";
}
